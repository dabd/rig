# Core zsh config, managed in the rig repo. Work overlay (if any): ~/.zshrc.work,
# sourced after this file by the ~/.zshrc stub, so its definitions win.

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git dircycle direnv docker-compose colored-man-pages zsh-autosuggestions zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh

# Nix
if [ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

# Version managers
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init - zsh)"

export PATH="/Applications/IntelliJ IDEA.app/Contents/MacOS:$PATH"
export PATH="$HOME/.tgenv/bin:$PATH"
export PATH="$HOME/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.emacs.d/bin:$PATH"
export PATH="/opt/homebrew/opt/grep/libexec/gnubin:$PATH"
# Coursier (Scala) installs its binaries here. Appended, not prepended, so the
# Nix profile keeps priority.
export PATH="$PATH:$HOME/Library/Application Support/Coursier/bin"

HISTSIZE=10000
SAVEHIST=10000

export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# sbt needs more heap and a deeper stack than the JVM defaults for Scala builds.
export SBT_OPTS="-Xms2G -Xmx8G -Xss8M"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Terraform: one shared provider cache instead of ~500MB per project dir.
export TF_PLUGIN_CACHE_DIR="$HOME/.terraform.d/plugin-cache"

# Build for amd64 by default on Apple silicon, matching the deploy targets.
export DOCKER_DEFAULT_PLATFORM=linux/amd64

tmux_extract_window() {
    local window_num=${1:-$(tmux display-message -p '#I')}
    local session_name="extracted_${window_num}_$(date +%s)"

    tmux new-session -d -s "$session_name"
    tmux move-window -s ":$window_num" -t "$session_name:0"

    echo "Window $window_num moved to session '$session_name'"
    echo "Attach with: tmux attach-session -t $session_name"
}

# Personal Claude Code profile (subscription; separate config/state dirs).
function claude-personal {
  CLAUDE_CONFIG_DIR="$HOME/.claude-personal" \
  CODEX_HOME="$HOME/.codex-personal" \
  CLAUDE_CODE_USE_BEDROCK=0 \
  command claude "$@"
}

# Find the real codex binary, skipping the ~/.local/bin shim.
_codex_real() {
  local dir candidate
  for dir in ${(s.:.)PATH}; do
    [[ "$dir" == "$HOME/.local/bin" ]] && continue
    candidate="$dir/codex"
    if [[ -x "$candidate" ]]; then
      print -r -- "$candidate"
      return 0
    fi
  done

  echo "Real Codex binary not found on PATH outside ~/.local/bin" >&2
  return 1
}

function codex-personal {
  local real_codex
  real_codex="$(_codex_real)" || return 1
  CODEX_HOME="$HOME/.codex-personal" "$real_codex" "$@"
}

# sos = Save Our Sessions. After a tmux crash there is no live Claude to ask,
# so recovery is a plain command: print the resume command per restored pane
# (stdout) plus the unplaced-sessions report (stderr). Drives nothing.
alias sos="$HOME/tools/save-our-sessions/plugins/tmux-session-recovery/scripts/tmux-agent-recover.sh"

# Emacs (Nix macport): launch the GUI via the .app bundle (Launch Services), so
# the window gets proper macOS keyboard focus. Running the bare binary or a
# launchd-daemon GUI frame does NOT get focus (keystrokes leak to the terminal).
# `ec` opens the GUI app (optionally with files); `et` opens a quick terminal Emacs.
ec() { open -a "$HOME/.nix-profile/Applications/Emacs.app" "$@"; }
et() { "$HOME/.nix-profile/bin/emacs" -nw "$@"; }

# bcode: opt out of anonymous usage traces, scoped to the invocation only (a
# global export disables Claude Code's feature-flag evaluation).
export PATH="$HOME/.bcode/bin:$PATH"
bcode() { DO_NOT_TRACK=1 command bcode "$@" }
