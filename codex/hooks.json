{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/tools/save-our-sessions/plugins/tmux-session-recovery/scripts/record-codex-session.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CC_SAFETY_NET_STRICT=1 CC_SAFETY_NET_PARANOID_RM=1 \"@HOME@/.nix-profile/bin/node\" \"@HOME@/.local/share/cc-safety-net/v1.0.6/node_modules/cc-safety-net/dist/bin/cc-safety-net.js\" hook --claude-code"
          }
        ]
      }
    ]
  }
}
